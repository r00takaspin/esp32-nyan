{
  "name": "@local/dsh-agent-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Desk-side Agent Buddy on a Waveshare ESP32-S3-Touch-LCD-1.47: live agent status and physical approve/deny.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "bridge.py", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
